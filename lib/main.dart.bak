                                              const UnderlineInputBorder(
                                                borderSide: BorderSide(
                                                  color: Colors.amber,
                                                  width: 2,
                                                ),
                                              ),
                                        ),
                                        onChanged: (value) {
                                          if (value.length >
                                              _previousText.length) {
                                            _tryCalculateFormula(value);
                                          }
                                          _previousText = value;
                                        },

          child: Column(
            children: [
              // Filter Panel
              if (_showFilterPanel)
                Container(
                  color: Colors.grey.shade100,
                  padding: const EdgeInsets.all(12),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      // Reverse Sorting Checkbox
                      Row(
